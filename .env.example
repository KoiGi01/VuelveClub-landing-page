# Resend API key (required). Get one at https://resend.com
RESEND_API_KEY=

# Landing form recipients (comma-separated).
LEAD_TO_EMAIL=luismedlozn@gmail.com,support@vuelveclub.com

# Support form and chatbot handoff recipient.
SUPPORT_TO_EMAIL=support@vuelveclub.com

# From address. vuelveclub.com must be verified in Resend.
LEAD_FROM_EMAIL=support@vuelveclub.com

# Server-only Gemini key. Never include in browser configuration.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Public PostHog project token (phc_...). NOT a personal API key.
# Analytics activates only on Vercel production. Redeploy after changing these.
POSTHOG_PROJECT_TOKEN=
POSTHOG_REGION=US

# Clerk public publishable key. Google OAuth must be enabled in Clerk.
# Production requires pk_live_...; never put a Secret Key in this variable.
CLERK_PUBLISHABLE_KEY=
# Clerk Production Secret Key for server-side organization/team administration.
# Never expose this in a public config endpoint or frontend bundle.
CLERK_SECRET_KEY=

# Comma-separated immutable Clerk user IDs with platform administrator access.
# This server-side policy never trusts email, query strings or browser metadata.
VUELVE_ADMIN_USER_IDS=

# Google Wallet server-side credentials. Never expose through public config APIs.
GOOGLE_WALLET_ISSUER_ID=3388000000023226779
# Single-line JSON from the service account key file; quote with single quotes locally.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# Server-only Vercel Blob credentials for public business-logo images.
# The Vercel storage connection configures production values automatically.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Supabase project API URL (https://<project-ref>.supabase.co), not dashboard URL.
# Server-only secret. Never include either variable in a public config response.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional direct/session-pooler PostgreSQL connection for applying migrations.
# Include the database password; keep this only in the local ignored file.
SUPABASE_DB_URL=
# Alternative to DB URL: direct PostgreSQL password for local migrations only.
SUPABASE_DB_PASSWORD=
