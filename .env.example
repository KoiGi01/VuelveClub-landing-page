# Resend API key (required). Get one at https://resend.com
RESEND_API_KEY=

# Where leads are delivered. Defaults to luismedlozn@gmail.com if unset.
LEAD_TO_EMAIL=luismedlozn@gmail.com

# Where support tickets are delivered. Defaults to luismedlozn@gmail.com if unset.
SUPPORT_TO_EMAIL=luismedlozn@gmail.com

# From address. Use onboarding@resend.dev until vuelveclub.com is verified in Resend.
LEAD_FROM_EMAIL=onboarding@resend.dev

# Public PostHog project token (phc_...). NOT a personal API key.
# Analytics activates only on Vercel production. Redeploy after changing these.
POSTHOG_PROJECT_TOKEN=
POSTHOG_REGION=US

# Clerk public publishable key. Google OAuth must be enabled in Clerk.
# Production requires pk_live_...; never put a Secret Key in this variable.
CLERK_PUBLISHABLE_KEY=
